{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "准备调试目录",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/launch-debug-host.mjs",
        "--prepare"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "构建插件",
      "type": "npm",
      "script": "build",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "准备并构建插件",
      "dependsOrder": "sequence",
      "dependsOn": [
        "准备调试目录",
        "构建插件"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
