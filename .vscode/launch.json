{
  "version": "0.2.0",
  // 宿主由 scripts/launch-debug-host.mjs 另起进程，调试器无法像 extensionHost 那样自动附加，
  // 因此每个宿主都是「启动 + 附加」的组合：启动项给宿主开出 inspector 端口，附加项接上之后断点才能命中。
  "configurations": [
    {
      "name": "启动调试宿主",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-debug-host.mjs",
      "args": ["--host=${input:debugHost}"],
      "autoAttachChildProcesses": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "准备并构建插件",
      "presentation": { "hidden": true }
    },
    {
      "name": "启动 VS Code 宿主",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-debug-host.mjs",
      "args": ["--host=vscode"],
      "autoAttachChildProcesses": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "准备并构建插件",
      "presentation": { "hidden": true }
    },
    {
      "name": "启动 Cursor 宿主",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-debug-host.mjs",
      "args": ["--host=cursor"],
      "autoAttachChildProcesses": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "准备并构建插件",
      "presentation": { "hidden": true }
    },
    {
      // 端口与 launch-debug-host.mjs 的 DEFAULT_INSPECT_PORT 一致；timeout 覆盖构建与宿主启动的时间。
      "name": "附加到扩展宿主",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "timeout": 60000,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      "name": "调试 My Setting Sync",
      "configurations": ["启动调试宿主", "附加到扩展宿主"],
      "stopAll": true
    },
    {
      "name": "调试 VS Code",
      "configurations": ["启动 VS Code 宿主", "附加到扩展宿主"],
      "stopAll": true
    },
    {
      "name": "调试 Cursor",
      "configurations": ["启动 Cursor 宿主", "附加到扩展宿主"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "debugHost",
      "type": "pickString",
      "description": "选择调试宿主",
      "options": [
        {
          "label": "VS Code",
          "value": "vscode"
        },
        {
          "label": "Cursor",
          "value": "cursor"
        }
      ],
      "default": "vscode"
    }
  ]
}
